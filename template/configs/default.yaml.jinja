# All parameters live here. Code reads this file; no magic numbers in src/.
seed: 42

paths:
  raw: data/raw
  interim: data/interim
  processed: data/processed
  models: models
  reports: reports
  figures: reports/figures

data:
  name: "{{ dataset_name }}"
  url: "{{ dataset_url }}"
  licence: "{{ dataset_license }}"
  # One entry per file. Fill sha256 after the first verified download
  # (run `sha256sum <file>` and paste). `url: null` = manual download (licence requires it).
  files: []
  #  - name: example.parquet
  #    url: https://...
  #    sha256: "..."

split:
  # Decided in stage 4 and documented in docs/02-split-and-leakage.md
  strategy: time        # time | group | group_time | rolling_origin
  group_col: null
  time_col: null

evaluation:
  bootstrap_resamples: 1000
  ci: 0.95

publish:
  slug: "{{ portfolio_slug }}"
  figures:            # ordered; becomes the website carousel order
    - 00-hero.png
